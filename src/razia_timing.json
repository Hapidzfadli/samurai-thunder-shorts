  "lines": {
    "h1": {
      "scene": "hook",
      "speaker": "nadia",
      "emotion": "narasi",
      "text": "Hai wak! Di kosan Bu Tini aturan nomor satunya dilarang pelihara hewan, tapi Riko malah diam-diam kasih ikan tongkol ke kucing oren!",
      "startSec": 0.32,
      "endSec": 8.696,
      "from": 10,
      "to": 261,
      "globalFrom": 10,
      "globalTo": 261
    },
    "h2": {
      "scene": "hook",
      "speaker": "riko",
      "emotion": "bisik",
      "text": "Ssst, makan pelan-pelan ya Oren! Kalau ketahuan Bu Tini, kita berdua langsung angkat koper sore ini!",
      "startSec": 8.816,
      "endSec": 14.249,
      "from": 264,
      "to": 427,
      "globalFrom": 264,
      "globalTo": 427
    },
    "a1": {
      "scene": "alarm",
      "speaker": "bu_tini",
      "emotion": "tegas_galak",
      "text": "Perhatian semua penghuni lantai dua! Sore ini ada razia kamar kos mendadak! Siapkan kunci pintu!",
      "startSec": 14.973,
      "endSec": 21.542,
      "from": 10,
      "to": 207,
      "globalFrom": 449,
      "globalTo": 646
    },
    "a2": {
      "scene": "alarm",
      "speaker": "riko",
      "emotion": "panik",
      "text": "Gawat Gas, gawat! Itu suara Bu Tini bawa sapu! Sembunyiin Oren sekarang juga!",
      "startSec": 21.642,
      "endSec": 25.776,
      "from": 210,
      "to": 334,
      "globalFrom": 649,
      "globalTo": 773
    },
    "n1": {
      "scene": "nyamar",
      "speaker": "riko",
      "emotion": "panik",
      "text": "Masuk lemari penuh baju! Masuk ember kekecilan! Aduh Gas, taruh mana dong kucing gembul ini?!",
      "startSec": 26.38,
      "endSec": 31.139,
      "from": 8,
      "to": 151,
      "globalFrom": 791,
      "globalTo": 934
    },
    "n2": {
      "scene": "nyamar",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Tenang Rik, otak jeniusku kerja! Bungkus sarung bantal kuning, jadi bantal bulu edisi terbatas!",
      "startSec": 31.249,
      "endSec": 35.931,
      "from": 154,
      "to": 295,
      "globalFrom": 937,
      "globalTo": 1078
    },
    "d1": {
      "scene": "dobrak",
      "speaker": "bu_tini",
      "emotion": "galak",
      "text": "Riko! Kenapa kamar kamu bau ikan tongkol menyengat begini?! Kamu sembunyiin kucing ya?!",
      "startSec": 36.793,
      "endSec": 41.661,
      "from": 14,
      "to": 160,
      "globalFrom": 1104,
      "globalTo": 1250
    },
    "d2": {
      "scene": "dobrak",
      "speaker": "riko",
      "emotion": "ngeles",
      "text": "Bukan ikan tongkol Bu, itu... parfum baru aroma pantai Ancol! Lagi tren banget di kalangan mahasiswa!",
      "startSec": 41.781,
      "endSec": 47.633,
      "from": 163,
      "to": 339,
      "globalFrom": 1253,
      "globalTo": 1429
    },
    "b1": {
      "scene": "bocor",
      "speaker": "ara",
      "emotion": "polos",
      "text": "Eh Riko, bantal bulu di kasur kamu lucu banget! Tapi kok kupingnya gerak-gerak terus barusan ngeong?!",
      "startSec": 48.247,
      "endSec": 53.608,
      "from": 8,
      "to": 169,
      "globalFrom": 1447,
      "globalTo": 1608
    },
    "b2": {
      "scene": "bocor",
      "speaker": "riko",
      "emotion": "panik",
      "text": "Aduh Mbak Ara, jangan kencang-kencang! Tamat sudah riwayatku hari ini!",
      "startSec": 53.708,
      "endSec": 56.978,
      "from": 172,
      "to": 270,
      "globalFrom": 1611,
      "globalTo": 1709
    },
    "t1": {
      "scene": "twist",
      "speaker": "bu_tini",
      "emotion": "galak",
      "text": "Aha! Ketangkap basah kamu Riko! Sini saya tarik selimutnya sekarang!",
      "startSec": 57.527,
      "endSec": 61.57,
      "from": 8,
      "to": 129,
      "globalFrom": 1726,
      "globalTo": 1847
    },
    "t2": {
      "scene": "twist",
      "speaker": "bu_tini",
      "emotion": "luluh",
      "text": "Ya ampun... Gusti... matanya berbinar banget! Gemoy banget sih kamu, pus!",
      "startSec": 63.29,
      "endSec": 68.138,
      "from": 181,
      "to": 326,
      "globalFrom": 1899,
      "globalTo": 2044
    },
    "r1": {
      "scene": "rebutan",
      "speaker": "bu_tini",
      "emotion": "gemes",
      "text": "Sudah, mulai hari ini Oren ikut Ibu ke dapur makan ikan pindang! Kalian berdua keluar sana!",
      "startSec": 68.813,
      "endSec": 73.403,
      "from": 8,
      "to": 146,
      "globalFrom": 2064,
      "globalTo": 2202
    },
    "r2": {
      "scene": "rebutan",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Lho Bu, kok malah kita yang diusir dari kamar sendiri sih?!",
      "startSec": 73.523,
      "endSec": 76.798,
      "from": 150,
      "to": 248,
      "globalFrom": 2206,
      "globalTo": 2304
    },
    "r3": {
      "scene": "rebutan",
      "speaker": "ara",
      "emotion": "polos",
      "text": "Wah asyik! Berarti besok aku boleh pelihara bebek di kamar juga ya Bu?!",
      "startSec": 76.928,
      "endSec": 81.059,
      "from": 252,
      "to": 376,
      "globalFrom": 2308,
      "globalTo": 2432
    },
    "e1": {
      "scene": "ending",
      "speaker": "nadia",
      "emotion": "narasi_tutup",
      "text": "Hahaha, aturan galak langsung kalah sama tatapan kucing oren! Menurut kamu wak, kosan boleh pelihara kucing atau dilarang keras? Vote di komen!",
      "startSec": 81.767,
