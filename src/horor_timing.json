  "lines": {
    "h1": {
      "scene": "hook",
      "speaker": "narator",
      "emotion": "narasi",
      "text": "Malam Jumat tepat tengah malam, Riko nekat bikin konten uji nyali di rumah kosong angker!",
      "startSec": 0.35,
      "endSec": 5.31,
      "from": 10,
      "to": 159,
      "globalFrom": 10,
      "globalTo": 159
    },
    "h2": {
      "scene": "hook",
      "speaker": "riko",
      "emotion": "tegang",
      "text": "Gas, serius nih rumah ini angker banget! Tunggu, kamu bawa apaan tuh?!",
      "startSec": 5.53,
      "endSec": 9.05,
      "from": 166,
      "to": 271,
      "globalFrom": 166,
      "globalTo": 271
    },
    "h3": {
      "scene": "hook",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Tenang Rik, pisang goreng hangat sama kopi hitam! Siapa tahu hantunya lapar!",
      "startSec": 9.27,
      "endSec": 13.11,
      "from": 278,
      "to": 393,
      "globalFrom": 278,
      "globalTo": 393
    },
    "m1": {
      "scene": "masuk",
      "speaker": "riko",
      "emotion": "tegang",
      "text": "Pelan-pelan Mas Dedi, senter ke arah beringin! Eh, lampu terasnya kok berkedip sendiri?!",
      "startSec": 13.917,
      "endSec": 18.557,
      "from": 10,
      "to": 150,
      "globalFrom": 418,
      "globalTo": 557
    },
    "m2": {
      "scene": "masuk",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Santai aja, mungkin kabelnya kendor. Tapi kok ada bau menyan campur pisang goreng ya?",
      "startSec": 18.797,
      "endSec": 23.58,
      "from": 157,
      "to": 300,
      "globalFrom": 564,
      "globalTo": 707
    },
    "u1": {
      "scene": "muncul",
      "speaker": "pocong",
      "emotion": "tegang",
      "text": "Berani sekali kalian masuk rumah ini! Mau lari ke mana kalian?!",
      "startSec": 24.483,
      "endSec": 27.797,
      "from": 14,
      "to": 113,
      "globalFrom": 734,
      "globalTo": 834
    },
    "u2": {
      "scene": "muncul",
      "speaker": "riko",
      "emotion": "tegas",
      "text": "Ampun Kang Pocong! Mbak Kunti! Tolong, kakiku kaku tidak bisa lari!!",
      "startSec": 27.997,
      "endSec": 32.792,
      "from": 119,
      "to": 263,
      "globalFrom": 840,
      "globalTo": 984
    },
    "t1": {
      "scene": "tawar",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Eits, jangan seram-seram dulu Kang! Nih pisang goreng masih panas sama kopi hitam, monggo!",
      "startSec": 33.62,
      "endSec": 39.36,
      "from": 10,
      "to": 182,
      "globalFrom": 1009,
      "globalTo": 1181
    },
    "t2": {
      "scene": "tawar",
      "speaker": "pocong",
      "emotion": "santai",
      "text": "Eh, sebentar... ini pisang goreng kepok yang renyah itu ya? Boleh dicoba satu, Mas?",
      "startSec": 39.6,
      "endSec": 44.945,
      "from": 189,
      "to": 349,
      "globalFrom": 1188,
      "globalTo": 1348
    },
    "t3": {
      "scene": "tawar",
      "speaker": "kunti",
      "emotion": "santai",
      "text": "Wah, ada tahu isi juga! Ya ampun Mas, aromanya bikin lupa cara menakuti orang!",
      "startSec": 45.165,
      "endSec": 49.485,
      "from": 356,
      "to": 486,
      "globalFrom": 1355,
      "globalTo": 1485
    },
    "c1": {
      "scene": "curhat",
      "speaker": "kunti",
      "emotion": "santai",
      "text": "Aslinya capek banget tahu, Mas. Tiap malam Jumat harus lembur terbang demi konten uji nyali!",
      "startSec": 50.283,
      "endSec": 55.233,
      "from": 10,
      "to": 159,
      "globalFrom": 1508,
      "globalTo": 1657
    },
    "c2": {
      "scene": "curhat",
      "speaker": "pocong",
      "emotion": "narasi",
      "text": "Iya nih, betis saya pegal banget melompat terus! Padahal maunya cuma rebahan sambil ngopi!",
      "startSec": 55.453,
      "endSec": 60.964,
      "from": 166,
      "to": 331,
      "globalFrom": 1664,
      "globalTo": 1829
    },
    "c3": {
      "scene": "curhat",
      "speaker": "bagas",
      "emotion": "santai",
      "text": "Waduh, ternyata hantu juga butuh istirahat ya Kang! Ambil lagi tahu isinya, masih banyak!",
      "startSec": 61.184,
      "endSec": 66.994,
      "from": 338,
      "to": 512,
      "globalFrom": 1836,
      "globalTo": 2010
    },
    "v1": {
      "scene": "viral",
      "speaker": "riko",
      "emotion": "tegas",
      "text": "Waduh Gas! Siaran langsung di ponselku masih menyala! Penontonnya tembus ribuan!!",
      "startSec": 67.753,
      "endSec": 72.793,
      "from": 10,
      "to": 161,
      "globalFrom": 2033,
      "globalTo": 2184
    },
    "v2": {
      "scene": "viral",
      "speaker": "pocong",
      "emotion": "santai",
      "text": "Halo penonton di rumah! Ini bukan uji nyali, ini acara ngopi dan gorengan tengah malam!",
      "startSec": 73.033,
      "endSec": 79.21,
      "from": 168,
