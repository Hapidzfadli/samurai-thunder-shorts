  "lines": {
    "h1": {
      "scene": "hook",
      "emotion": "narasi",
      "text": "Malam Jumat tepat tengah malam, Riko nekad bikin konten uji nyali di rumah kosong angker biar viral.",
      "startSec": 0.38,
      "endSec": 5.98,
      "from": 11,
      "to": 179,
      "globalFrom": 11,
      "globalTo": 179
    },
    "h2": {
      "scene": "hook",
      "emotion": "santai",
      "text": "Padahal lututnya sudah gemetaran, sementara Bagas malah santai menenteng sekantong pisang goreng hangat!",
      "startSec": 6.23,
      "endSec": 11.99,
      "from": 187,
      "to": 360,
      "globalFrom": 187,
      "globalTo": 360
    },
    "m1": {
      "scene": "masuk",
      "emotion": "tegang",
      "text": "Sambil berjalan mengendap-endap, Mas Dedi menyapu halaman gelap penuh kabut dengan senter terang.",
      "startSec": 12.913,
      "endSec": 17.553,
      "from": 11,
      "to": 151,
      "globalFrom": 387,
      "globalTo": 527
    },
    "m2": {
      "scene": "masuk",
      "emotion": "narasi",
      "text": "Tiba-tiba lampu teras berkedip aneh dan angin dingin menggoyang akar pohon beringin keramat!",
      "startSec": 17.803,
      "endSec": 22.743,
      "from": 158,
      "to": 306,
      "globalFrom": 534,
      "globalTo": 682
    },
    "u1": {
      "scene": "muncul",
      "emotion": "tegang",
      "text": "Seketika kabut biru menyala, Kang Pocong melompat dari balik beringin dan Mbak Kunti melayang turun dari balkon!",
      "startSec": 23.65,
      "endSec": 29.71,
      "from": 10,
      "to": 192,
      "globalFrom": 710,
      "globalTo": 891
    },
    "u2": {
      "scene": "muncul",
      "emotion": "tegas",
      "text": "Riko dan Mas Dedi langsung membeku kaku seperti patung dengan keringat dingin mengucur deras!",
      "startSec": 29.99,
      "endSec": 34.63,
      "from": 201,
