  "lines": {
    "h1": {
      "scene": "hook",
      "speaker": "nadia",
      "emotion": "hook",
      "text": "Hai wak! Empat puluh delapan penumpang Garuda disandera empat hari di Bangkok.",
      "startSec": 0.35,
      "endSec": 4.19,
      "from": 10,
      "to": 126,
      "globalFrom": 10,
      "globalTo": 126
    },
    "h2": {
      "scene": "hook",
      "speaker": "nadia",
      "emotion": "hook",
      "text": "Tapi pasukan khusus Indonesia menuntaskannya kurang dari tiga menit!",
      "startSec": 4.33,
      "endSec": 7.85,
      "from": 130,
      "to": 236,
      "globalFrom": 130,
      "globalTo": 236
    },
    "k1": {
      "scene": "krisis",
      "speaker": "nadia",
      "emotion": "tegang",
      "text": "Dua puluh delapan Maret seribu sembilan ratus delapan puluh satu, pesawat Garuda Woyla dibajak lima pria bersenjata.",
      "startSec": 8.5,
      "endSec": 14.02,
      "from": 9,
      "to": 175,
      "globalFrom": 255,
      "globalTo": 421
    },
    "k2": {
      "scene": "krisis",
      "speaker": "nadia",
      "emotion": "tegang",
      "text": "Pesawat dipaksa mendarat di Bandara Don Mueang, sementara para sandera hanya bisa menunduk ketakutan.",
      "startSec": 14.16,
      "endSec": 18.56,
      "from": 179,
      "to": 311,
      "globalFrom": 425,
      "globalTo": 557
    },
    "k3": {
      "scene": "krisis",
      "speaker": "nadia",
      "emotion": "haru",
      "text": "Di depan kokpit yang pengap, Kapten Herman Rante berdiri tegar melindungi awak dan seluruh penumpangnya.",
      "startSec": 18.72,
      "endSec": 23.84,
      "from": 316,
      "to": 469,
      "globalFrom": 562,
      "globalTo": 715
    },
    "b1": {
      "scene": "briefing",
      "speaker": "nadia",
      "emotion": "taktis",
      "text": "Dari Jakarta, tiga puluh lima prajurit Kopassandha pimpinan Letkol Sintong Panjaitan terbang rahasia menyusun serbuan tiga arah.",
      "startSec": 24.5,
      "endSec": 30.98,
      "from": 9,
      "to": 203,
      "globalFrom": 735,
      "globalTo": 929
    },
    "b2": {
      "scene": "briefing",
      "speaker": "nadia",
      "emotion": "taktis",
      "text": "Tim Merah dan Tim Biru memanjat sayap ke pintu darurat, sementara Tim Hijau menyusup lewat tangga ekor.",
      "startSec": 31.13,
      "endSec": 36.73,
      "from": 208,
      "to": 376,
      "globalFrom": 934,
      "globalTo": 1102
    },
    "s1": {
      "scene": "susup",
      "speaker": "nadia",
      "emotion": "bisik",
      "text": "Dini hari tiga puluh satu Maret pukul dua lewat empat puluh lima, hujan gelap mengguyur landasan.",
      "startSec": 37.387,
      "endSec": 42.587,
      "from": 10,
      "to": 166,
      "globalFrom": 1122,
      "globalTo": 1278
    },
    "s2": {
      "scene": "susup",
      "speaker": "nadia",
      "emotion": "bisik",
      "text": "Para prajurit merayap senyap menempel di badan pesawat tanpa satu pun suara.",
      "startSec": 42.727,
      "endSec": 46.487,
      "from": 170,
      "to": 283,
      "globalFrom": 1282,
      "globalTo": 1395
    },
    "a1": {
      "scene": "ababa",
      "speaker": "sintong",
      "emotion": "radio",
      "text": "Semua tim, posisi siap di pintu masing-masing! Tiga, dua, satu, laksanakan!",
      "startSec": 47.08,
      "endSec": 50.92,
      "from": 8,
      "to": 124,
      "globalFrom": 1412,
      "globalTo": 1528
    },
    "c1": {
      "scene": "klimaks",
      "speaker": "nadia",
      "emotion": "klimaks",
      "text": "Pin granat kejut dicabut, ketiga pintu didobrak serentak, dan ledakan cahaya putih menyilaukan melumpuhkan para pembajak!",
      "startSec": 53.52,
      "endSec": 59.44,
      "from": 43,
      "to": 220,
      "globalFrom": 1606,
      "globalTo": 1783
    },
    "c2": {
      "scene": "klimaks",
      "speaker": "nadia",
      "emotion": "klimaks",
      "text": "Di tengah hujan peluru yang seakan membeku di udara, prajurit Kopassandha menerjang mengamankan kokpit dan melindungi sandera!",
      "startSec": 59.72,
      "endSec": 66.44,
      "from": 229,
      "to": 430,
      "globalFrom": 1792,
      "globalTo": 1993
    },
    "e1": {
      "scene": "evakuasi",
      "speaker": "nadia",
      "emotion": "heroik",
      "text": "Hanya dalam dua menit lima puluh delapan detik, seluruh pembajak berhasil dilumpuhkan.",
      "startSec": 67.233,
      "endSec": 71.713,
      "from": 9,
      "to": 143,
      "globalFrom": 2017,
      "globalTo": 2151
    },
    "e2": {
      "scene": "evakuasi",
      "speaker": "nadia",
      "emotion": "heroik",
      "text": "Semua penumpang sipil berlari turun tangga darurat dalam keadaan selamat!",
      "startSec": 71.853,
      "endSec": 75.533,
      "from": 148,
      "to": 258,
      "globalFrom": 2156,
      "globalTo": 2266
    },
    "p1": {
      "scene": "epilog",
      "speaker": "nadia",
      "emotion": "tribute",
      "text": "Kemenangan ini dibayar mahal oleh gugurnya Peltu Achmad Kirang dan Kapten Herman Rante.",
      "startSec": 76.253,
      "endSec": 81.053,
      "from": 10,
      "to": 154,
      "globalFrom": 2288,
      "globalTo": 2432
    },
    "p2": {
      "scene": "epilog",
      "speaker": "nadia",
      "emotion": "tribute",
      "text": "Operasi Woyla mengguncang dunia dan melahirkan Satuan delapan puluh satu Gultor Kopassus!",
      "startSec": 81.233,
      "endSec": 85.793,
      "from": 159,
      "to": 296,
      "globalFrom": 2437,
      "globalTo": 2574
    }
  },
