  "t1": {
   "scene": "tantang",
   "text": "Suatu hari, Raja Harun Ar-Rasyid ingin menjebak Abu Nawas.",
   "from": 3,
   "to": 91
  },
  "t2": {
   "scene": "tantang",
   "text": "Abu Nawas! Tangkap angin, dan bawa ke hadapanku dalam tiga hari! Kalau gagal, kau dihukum!",
   "from": 94,
   "to": 242
  },
  "t3": {
   "scene": "tantang",
   "text": "Para wazir tertawa. Mana mungkin angin bisa ditangkap?",
