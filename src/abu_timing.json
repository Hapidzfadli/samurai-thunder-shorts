  },
  "m2": {
   "scene": "malam",
   "text": "Abu Nawas berpikir keras, semalaman.",
   "from": 80,
   "to": 133
  },
  "k1": {
   "scene": "kentut",
   "text": "Hari ketiga, perutnya mulas. Lalu...",
   "from": 3,
   "to": 51
  },
  "k2": {
   "scene": "kentut",
   "text": "Nah! Ini dia anginnya!",
   "from": 83,
   "to": 121
  },
  "k3": {
   "scene": "kentut",
   "text": "Cepat-cepat, ia menangkapnya ke dalam botol, dan menyumbatnya rapat-rapat.",
