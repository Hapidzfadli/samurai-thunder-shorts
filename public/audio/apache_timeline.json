      "phrases": [
        {
          "emotion": "narasi",
          "text": "Kamera panas di hidungnya mengirim gambar ke lensa kecil di mata kanan.",
          "startSec": 23.814,
          "endSec": 27.164
        },
        {
          "emotion": "tegang",
          "text": "Mata kanan melihat panas musuh, mata kiri melihat kokpit gelap.",
